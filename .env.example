DB_URL=jdbc:mysql://localhost:3306/finsight?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-with-a-local-development-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-root-password
DB_POOL_SIZE=10
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
JWT_SECRET=replace-with-a-base64-encoded-random-key-at-least-32-bytes
JWT_ISSUER=https://finsight-ai.local
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
REDIS_HOST=localhost
REDIS_PORT=6379
QDRANT_HOST=localhost
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=finsight_documents
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
FINSIGHT_AI_ENABLED=false
SPRING_AI_MODEL_CHAT=none
SPRING_AI_MODEL_EMBEDDING=none
MARKET_DATA_PROVIDER=unavailable
FINANCIAL_NEWS_PROVIDER=mock
FINANCIAL_NEWS_SYNC_ENABLED=false
FINANCIAL_NEWS_AUTO_SUMMARIZE=false
NEWS_SYNC_INITIAL_DELAY=10000
NEWS_SYNC_FIXED_DELAY=3600000
STOCK_EXPLORER_IMPORT_ENABLED=true
NSE_EQUITY_CSV_PATH=./data/nse/EQUITY_L.csv
FINSIGHT_MARKET_DATA_SYNC_ENABLED=false
FINSIGHT_NEWS_SYNC_ENABLED=false
DOCUMENT_STORAGE_DIR=./data/documents
DOCUMENT_MAX_FILE_SIZE=20MB
API_DOCS_ENABLED=true

