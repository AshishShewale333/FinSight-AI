{
  "info": {
    "_postman_id": "8a5d0083-5888-4bc3-8f44-18c7fbafc2c1",
    "name": "FinSight AI API",
    "description": "Local API collection. Register or log in, create a portfolio, enable MARKET_DATA_PROVIDER=mock, and import/search NSE listings. Use the tradable listings request to capture a listingId, then place, edit, list, and cancel pending orders. Mock prices are practice values.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "portfolioId",
      "value": ""
    },
    {
      "key": "companyId",
      "value": "",
      "description": "Company ID is used for company quote APIs; orders use listingId."
    },
    {
      "key": "documentId",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "listingId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "symbol",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "http://localhost:8080/actuator/health"
      }
    },
    {
      "name": "Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json().data;",
              "if (body) { pm.collectionVariables.set('accessToken', body.accessToken); pm.collectionVariables.set('refreshToken', body.refreshToken); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"person@example.com\",\n  \"password\": \"a-long-unique-passphrase\",\n  \"displayName\": \"Person\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json().data;",
              "if (body) { pm.collectionVariables.set('accessToken', body.accessToken); pm.collectionVariables.set('refreshToken', body.refreshToken); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"person@example.com\",\n  \"password\": \"a-long-unique-passphrase\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Refresh token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/refresh"
      }
    },
    {
      "name": "Current user",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/users/me"
      }
    },
    {
      "name": "Search companies",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/companies?query=Reliance&page=0&size=25"
      }
    },
    {
      "name": "Create portfolio",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json().data;",
              "if (body) pm.collectionVariables.set('portfolioId', body.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Long term\",\n  \"baseCurrency\": \"INR\"\n}"
        },
        "url": "{{baseUrl}}/portfolios"
      }
    },
    {
      "name": "Portfolio analytics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/portfolios/{{portfolioId}}/analytics"
      }
    },
    {
      "name": "Create chat session",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json().data;",
              "if (body) pm.collectionVariables.set('sessionId', body.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Annual report questions\",\n  \"documentId\": \"{{documentId}}\"\n}"
        },
        "url": "{{baseUrl}}/ai/chat/sessions"
      }
    },
    {
      "name": "Ask assistant",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"question\": \"What are the major risks mentioned in the report?\"\n}"
        },
        "url": "{{baseUrl}}/ai/chat"
      }
    },
    {
      "name": "List notifications",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/notifications?page=0&size=20"
      }
    },
    {
      "request": {
        "url": "{{baseUrl}}/stock-explorer?query=Reliance&page=0&size=100",
        "method": "GET",
        "header": [
          {
            "value": "Bearer {{accessToken}}",
            "key": "Authorization"
          }
        ]
      },
      "name": "Stock Explorer directory"
    },
    {
      "request": {
        "url": "{{baseUrl}}/news?page=0&size=20",
        "method": "GET",
        "header": [
          {
            "value": "Bearer {{accessToken}}",
            "key": "Authorization"
          }
        ]
      },
      "name": "Market news"
    },
    {
      "name": "Live mock quotes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/market/mock-stocks"
      }
    },
    {
      "name": "Tradable NSE listings (save first listingId)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json().data || [];",
              "if (data.length) { pm.collectionVariables.set('listingId', data[0].id); pm.collectionVariables.set('symbol', data[0].symbol); }",
              "pm.test('At least one tradable listing is available', () => pm.expect(data.length).to.be.above(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/market/mock-stocks/tradable-listings"
      }
    },
    {
      "name": "Place pending LIMIT buy order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"listingId\": \"{{listingId}}\",\n  \"side\": \"BUY\",\n  \"orderType\": \"LIMIT\",\n  \"quantity\": 2,\n  \"limitPrice\": 1\n}"
        },
        "url": "{{baseUrl}}/portfolios/{{portfolioId}}/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const order = pm.response.json().data;",
              "if (order) pm.collectionVariables.set('orderId', order.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List portfolio orders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/portfolios/{{portfolioId}}/orders"
      }
    },
    {
      "name": "Modify pending order",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"listingId\": \"{{listingId}}\",\n  \"side\": \"BUY\",\n  \"orderType\": \"LIMIT\",\n  \"quantity\": 3,\n  \"limitPrice\": 2\n}"
        },
        "url": "{{baseUrl}}/portfolios/{{portfolioId}}/orders/{{orderId}}"
      }
    },
    {
      "name": "Cancel pending order",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/portfolios/{{portfolioId}}/orders/{{orderId}}"
      }
    },
    {
      "request": {
        "url": "{{baseUrl}}/portfolios/{{portfolioId}}/holdings",
        "method": "GET",
        "header": [
          {
            "value": "Bearer {{accessToken}}",
            "key": "Authorization"
          }
        ]
      },
      "name": "Portfolio holdings"
    }
  ]
}
